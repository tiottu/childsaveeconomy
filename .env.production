# 배포 빌드에 들어가는 Supabase 연결 정보.
#
# 이 파일은 저장소에 그대로 올라간다. 괜찮다 —
#  - URL 은 주소일 뿐이고
#  - publishable key 는 원래 공개되는 값이다. 어차피 앱 번들에 박혀 나가므로
#    브라우저 개발자도구를 열면 누구나 볼 수 있다.
# 접근을 막는 건 이 키가 아니라 RLS 와 로그인이다.
#
# 절대 여기 넣지 말 것: Database Password, service_role / Secret key (sb_secret_...).
# 그 둘은 RLS 를 건너뛰므로 공개 저장소에 올라가면 데이터가 통째로 열린다.
#
# GitHub Actions 의 Variables 로도 같은 값을 줄 수 있는데, 그건 저장소 설정 화면에서
# 사람이 넣어야 한다. 파일로 두면 저장소만 있으면 빌드가 항상 같게 나온다.

VITE_SUPABASE_URL=https://tbzvafsqmvxboeqcxebf.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_5MsBAtlKBo_9BuThkGr92A_AVQ-kUFU
